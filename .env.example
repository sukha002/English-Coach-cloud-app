DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Add the production HTTPS origin when deploying:
CSRF_TRUSTED_ORIGINS=
# Optional; without it, a rule-based fallback is used:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional PostgreSQL URL; SQLite is used locally if omitted:
DATABASE_URL=
